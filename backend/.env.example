# Copiar a backend/.env. Ajustar servidor/puerto a la instancia local de SQL Server.
# Ejemplo para Windows con autenticacion integrada; no contiene credenciales.
SQLSERVER_URL="sqlserver://localhost:1433;database=NexoSaludDB;integratedSecurity=true;trustServerCertificate=true;"
OLTP_CONNECTION_STRING="Driver={ODBC Driver 17 for SQL Server};Server=localhost;Database=NexoSaludDB;Trusted_Connection=yes;TrustServerCertificate=yes;"
MART_CONNECTION_STRING="Driver={ODBC Driver 17 for SQL Server};Server=localhost;Database=NexoSalud_Mart;Trusted_Connection=yes;TrustServerCertificate=yes;"
PORT=3001

# Para pruebas Buyer: no ejecutar automaticamente cobranza/cancelaciones de PAYER.
# Si falta esta variable, se conserva el comportamiento anterior (activado).
DUNNING_ENABLED=false

# Registra la misma URL en Canva Developer Portal > Outside Canva > Redirect URLs.
CANVA_REDIRECT_URI=http://127.0.0.1:3001/api/canva/callback
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_BRAND_TEMPLATE_ID=
FRONTEND_URL=http://localhost:5173

# OpenWA (rmyndharis) para el envío manual de propuestas LEAD.
OPENWA_BASE_URL=http://127.0.0.1:2785
OPENWA_SESSION_ID=
OPENWA_API_KEY=
# Opcional. Para pruebas en esta PC: http://localhost:5173 (si WhatsApp lo muestra
# como texto, cópialo en el navegador de la misma PC).
# Para clientes, usa el origen HTTPS del portal con acceso a su API de prerreserva.
LEAD_PUBLIC_RESERVATION_URL=

# Chatbot LEAD en WhatsApp. Usar una segunda clave de Groq exclusiva del backend.
GROQ_LEAD_CHATBOT_API_KEY=
GROQ_LEAD_CHATBOT_MODEL=openai/gpt-oss-20b
# Mismo secreto que se registra en el webhook de OpenWA.
OPENWA_LEAD_WEBHOOK_SECRET=
