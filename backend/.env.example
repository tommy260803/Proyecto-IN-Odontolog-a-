# Copiar a backend/.env. Ajustar servidor/puerto a la instancia local de SQL Server.
# Ejemplo para Windows con autenticacion integrada; no contiene credenciales.
SQLSERVER_URL="sqlserver://localhost:1433;database=NexoSaludDB;integratedSecurity=true;trustServerCertificate=true;"
OLTP_CONNECTION_STRING="Driver={ODBC Driver 17 for SQL Server};Server=localhost;Database=NexoSaludDB;Trusted_Connection=yes;TrustServerCertificate=yes;"
MART_CONNECTION_STRING="Driver={ODBC Driver 17 for SQL Server};Server=localhost;Database=NexoSalud_Mart;Trusted_Connection=yes;TrustServerCertificate=yes;"
PORT=3001

# Para pruebas Buyer: no ejecutar automaticamente cobranza/cancelaciones de PAYER.
# Si falta esta variable, se conserva el comportamiento anterior (activado).
DUNNING_ENABLED=false

# Agente clasificador Buyer con @google/genai (modelo gemini-3.5-flash-lite)
GEMINI_API_KEY="tu_clave_gemini_api_aqui"
